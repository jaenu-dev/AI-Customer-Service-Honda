# Salin menjadi infra/.env. File .env TIDAK BOLEH di-commit.

# Pin ke versi n8n tertentu (lihat https://github.com/n8n-io/n8n/releases), jangan pakai "latest"
N8N_VERSION=

# Kunci enkripsi credential n8n. Buat dengan: openssl rand -hex 32
# SIMPAN baik-baik: tanpa kunci ini credential di database n8n tidak bisa dibuka lagi.
N8N_ENCRYPTION_KEY=

# URL publik untuk webhook (domain/ngrok). Kosongkan jika hanya lokal.
WEBHOOK_URL=
