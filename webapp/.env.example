# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK BOLEH di-commit.

NODE_ENV=development
PORT=3000

# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase → Project Settings → API. Gunakan service_role key (khusus server).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL webhook n8n dan secret yang sama dengan credential "Header Auth" di n8n
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/honda-ai-cs
N8N_WEBHOOK_SECRET=
